<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration for rclicker (paste into the SignPath project; see docs/code-signing.md).
  Input: the "rclicker-win-x64" GitHub Actions artifact, a zip holding rclicker.exe.
  Only an exe whose metadata says product "rclicker" at the version CI passes in gets signed.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="rclicker.exe" product-name="rclicker" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
