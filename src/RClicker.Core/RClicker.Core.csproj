<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Platform-neutral core: sessions, protocol, command routing, QR generation and the
    cloud relay client. Kept free of Windows APIs so it can be unit tested on any OS.
    Windows-specific code lives in RClicker.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>RClicker</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RClicker.Tests" />
  </ItemGroup>

</Project>
