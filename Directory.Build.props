<Project>
  <PropertyGroup>
    <Version>0.2.2</Version>
    <Product>rclicker</Product>
    <Company>rclicker</Company>
    <Copyright>Copyright (c) rclicker contributors</Copyright>
    <!-- Product version is exactly <Version> (no +commit suffix): code signing checks it. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- Lets the Windows desktop project build on Linux/macOS (CI and tooling). It still only runs on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <!-- Symbols inside the binaries, so a release is a single .exe with no loose .pdb files. -->
    <DebugType>embedded</DebugType>
  </PropertyGroup>
</Project>
